---
import { site, whatsappLink } from "../lib/site";

const links = [
  { href: "#servicios", label: "Servicios" },
  { href: "#precios", label: "Precios" },
  { href: "#ubicacion", label: "Ubicación" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-black/70 backdrop-blur-md"
>
  <nav
    class="container mx-auto flex h-16 items-center justify-between gap-4 px-4"
    aria-label="Navegación principal"
  >
    <a
      href="#inicio"
      class="shrink-0 text-base font-black italic tracking-tight text-white md:text-lg"
    >
      CAR<span class="text-lime-500">WASH</span>
      <span class="text-[0.6em] font-normal not-italic tracking-[0.35em] text-gray-400"
        >BLACK</span
      >
    </a>

    <ul class="hidden items-center gap-7 text-sm text-gray-300 sm:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors hover:text-lime-400 focus-visible:text-lime-400"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={whatsappLink("Hola, quiero agendar un lavado en Carwash Black.")}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center gap-2 rounded-full bg-lime-500 px-4 py-2 text-sm font-bold text-black transition hover:bg-lime-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-400"
    >
      <svg class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <use href="#whatsapp-icon"></use>
      </svg>
      <span>Agendar</span>
    </a>
  </nav>
</header>
