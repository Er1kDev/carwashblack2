---
import NavBar from "./NavBar.astro";
import Header from "./Header.astro";
import Highlights from "./Highlights.astro";
import Servicios from "./Servicios.astro";
import Precios from "./Precios.astro";
import Ubicacion from "./Ubicacion.astro";
import Footer from "./Footer.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
---

<div
  class="min-h-screen bg-linear-to-b from-stone-950 via-black to-stone-950"
>
  <NavBar />

  <main class="container mx-auto px-4 pt-16 text-zinc-300">
    <Header />
    <Highlights />
    <Servicios />
    <Precios />
    <Ubicacion />
  </main>

  <Footer />

  <WhatsAppButton />
</div>
