---
import { Image } from "astro:assets";
import Clientes from "../assets/images/clientes-sin-fondo.webp";
import HorariosPrecios from "../assets/images/horariosprecios-sin-fondo.webp";
import Retiros from "../assets/images/retiros-sin-fondo.webp";
import { site } from "../lib/site";

const items = [
  {
    imagen: Clientes,
    alt: "Clientes satisfechos de Carwash Black",
    label: "Clientes",
    href: site.social.instagram,
    externo: true,
  },
  {
    imagen: HorariosPrecios,
    alt: "Horarios y precios de Carwash Black",
    label: "Horarios y precios",
    href: "#precios",
    externo: false,
  },
  {
    imagen: Retiros,
    alt: "Servicio de retiro y entrega a domicilio",
    label: "Retiros y entregas",
    href: "#servicios",
    externo: false,
  },
];
---

<section
  aria-label="Por qué elegir Carwash Black"
  class="grid grid-cols-3 gap-2 pt-8 pb-4 md:gap-6 md:pt-12"
>
  {
    items.map((item) => (
      <a
        href={item.href}
        target={item.externo ? "_blank" : undefined}
        rel={item.externo ? "noopener noreferrer" : undefined}
        class="group flex flex-col items-center gap-2 rounded-2xl px-1 py-2 transition hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-400"
      >
        <Image
          src={item.imagen}
          alt={item.alt}
          widths={[128, 256]}
          sizes="(min-width: 768px) 128px, 96px"
          class="w-24 transition-transform duration-300 group-hover:scale-105 md:w-32"
        />
        <span class="text-center text-[11px] font-medium text-gray-400 transition group-hover:text-lime-400 md:text-sm">
          {item.label}
        </span>
      </a>
    ))
  }
</section>
