---
import { Image } from "astro:assets";
import { whatsappLink } from "../lib/site";

import moto_enduro_black from "../assets/images/moto_enduro_black.webp";
import spark from "../assets/images/spark.webp";
import mazda6 from "../assets/images/mazda6.webp";
import suv_jeep from "../assets/images/suvjeppblack.webp";
import camionetas from "../assets/images/camioneta-black.webp";
import camionetas_xl from "../assets/images/ford-f150.webp";

const servicios = [
  {
    nombre: "Motocicletas Enduro",
    precio: 10000,
    image: moto_enduro_black,
  },
  { nombre: "City Car", precio: 15000, image: spark },
  { nombre: "Sedán", precio: 20000, image: mazda6 },
  { nombre: "Suv o Jeep", precio: 25000, image: suv_jeep },
  { nombre: "Camionetas", precio: 30000, image: camionetas },
  { nombre: "Camionetas XL", precio: 35000, image: camionetas_xl },
];

const precioCLP = (valor: number) =>
  valor.toLocaleString("es-CL", { style: "currency", currency: "CLP" });
---

<div id="precios" class="scroll-mt-20 pb-10">
  <h3 class="py-12 text-center text-4xl font-semibold">Precios</h3>

  <p class="-mt-6 mb-8 text-center text-sm text-gray-400">
    Elige tu vehículo y agenda por WhatsApp.
  </p>

  <section>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        servicios.map((servicio) => (
          <article class="group flex flex-col overflow-hidden rounded-2xl border border-lime-500/20 bg-neutral-900 transition-all duration-500 hover:border-lime-500/50 hover:shadow-lg hover:shadow-lime-500/10">
            <div class="relative h-60 overflow-hidden bg-black">
              <Image
                src={servicio.image}
                alt={`${servicio.nombre} para lavado`}
                loading="lazy"
                class="h-full w-full object-cover opacity-60 transition-all duration-500 group-hover:scale-105 group-hover:opacity-80"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent" />
            </div>

            <div class="flex flex-1 flex-col justify-between p-6 text-white">
              <div>
                <h2 class="text-center text-2xl font-black italic text-lime-500 transition-colors duration-300 group-hover:text-white">
                  {servicio.nombre}
                </h2>
              </div>

              <div class="mt-4 space-y-4 border-t border-lime-500/20 pt-4 text-center">
                <p class="text-2xl">{precioCLP(servicio.precio)}</p>

                <a
                  href={whatsappLink(
                    `Hola, quiero agendar un lavado para ${servicio.nombre}.`,
                  )}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-full border border-lime-500/40 px-5 py-2 text-sm font-semibold text-lime-400 transition hover:bg-lime-500 hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-400"
                >
                  <svg class="h-4 w-4" fill="currentColor" aria-hidden="true">
                    <use href="#whatsapp-icon" />
                  </svg>
                  Agendar
                </a>
              </div>
            </div>

            <div class="border-t border-lime-500/10 bg-black/50 px-6 py-3 text-center">
              <p class="text-xs font-semibold tracking-[0.2em]">
                <span class="text-gray-400">CARWASH</span>
                <span class="text-lime-500"> BLACK</span>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</div>
