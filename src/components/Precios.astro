---
import { Image } from "astro:assets";
// import automovilesImage from "../assets/images/automoviles.webp";
// import motoEnduroImage from "../assets/images/moto_enduro.webp";
// import furgonImage from "../assets/images/furgon.webp";
// import suvJeepImage from "../assets/images/suv_jeep.webp";
// import camionetaImage from "../assets/images/camioneta.webp";
// import camionetasXlImage from "../assets/images/camionetas_xl.webp";

import moto_enduro_black from "../assets/images/moto_enduro_black.webp";
import city_card_sedan from "../assets/images/auto-citycar.webp";
import furgon from "../assets/images/furgon-black.webp";
import suv_jeep from "../assets/images/suvjeppblack.webp";
import camionetas from "../assets/images/camioneta-black.webp";
import camionetas_xl from "../assets/images/ford-f150.webp";

const servicios = [
  {
    nombre: "Motocicletas Enduros",
    precio: 10000,
    image: moto_enduro_black,
  },
  {
    nombre: "City Car & Sedán",
    precio: 18000,
    image: city_card_sedan,
  },
  {
    nombre: "Furgón",
    precio: 20000,
    image: furgon,
  },
  {
    nombre: "Suv o Jeep",
    precio: 25000,
    image: suv_jeep,
  },
  {
    nombre: "Camionetas",
    precio: 28000,
    image: camionetas,
  },
  {
    nombre: "Camionetas XL",
    precio: 30000,
    image: camionetas_xl,
  },
];
---

<div class="pb-10 animate-blurred-fade-in">
  <h3 class="py-12 text-center text-4xl md:text-4xl font-semibold">
    <span class="">Precios</span>
  </h3>

  <section class="min-h-screen">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        servicios.map((servicio, index) => (
          <article class="group flex flex-col overflow-hidden rounded-2xl bg-neutral-900 border border-lime-500/20 hover:border-lime-500/50 transition-all duration-500 hover:shadow-lg hover:shadow-lime-500/10">
            <div class="relative h-60 overflow-hidden bg-black">
              <Image
                src={servicio.image}
                alt={servicio.nombre}
                class="h-full w-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-105 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent" />
            </div>

            <div class="flex flex-col flex-1 justify-between p-6 text-white">
              <div>
                <h2 class="text-2xl text-center font-black italic text-lime-500 group-hover:text-white transition-colors duration-300">
                  {servicio.nombre}
                </h2>
              </div>

              <div class="mt-4 space-y-4 border-t text-center border-lime-500/20 pt-4">
                <p class="text-2xl  ">
                  {servicio.precio.toLocaleString("es-CL", {
                    style: "currency",
                    currency: "CLP",
                  })}
                </p>
              </div>
            </div>

            <div class="bg-black/50 px-6 py-3 text-center border-t border-lime-500/10">
              <p class="text-xs tracking-[0.2em] font-semibold">
                <span class="text-gray-400">CARWASH</span>
                <span class="text-lime-500"> BLACK</span>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {
    /* 
  <!-- SECCIÓN ALTERNATIVA: Grid listado de servicios -->
  <div class="grid grid-cols-1 gap-8 md:grid-cols-3 px-4 md:px-12">
    {
      servicios.map((servicio) => (
        <div class="flex flex-col items-center rounded-lg py-2 inset-shadow-sm inset-shadow-black bg-neutral-950">
          <div class="h-full flex flex-col items-center justify-start">
            <Image
              src={servicio.image}
              alt={servicio.nombre}
              loading="lazy"
              class="object-cover h-40 md:h-60 rounded-xl scale-75 md:scale-50 hover:scale-90 transition-transform duration-700"
            />
            <h3 class="text-2xl md:text-3xl font-semibold py-2 text-center">
              {servicio.nombre}
            </h3>
            <p class="text-2xl font-semibold text-gray-300 mb-2 text-center">
              {servicio.precio.toLocaleString("es-CL", {
                style: "currency",
                currency: "CLP",
              })}
            </p>
          </div>
        </div>
      ))
    }
  </div>
  -->
  */
  }
</div>
