  <h3 class="py-12 text-center text-4xl md:text-4xl font-semibold">
    <span class="">Servicios</span>
  </h3>

  <section class="min-h-screen">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      <!-- CARD 1 -->
      <article
        class="group relative overflow-hidden rounded-2xl bg-neutral-900 animate-fade-in-up hover:shadow-2xl hover:shadow-lime-500/20 transition-all duration-500 hover:scale-105"
        style="animation-delay: 100ms"
      >
        <Image
          src={AutoExterior}
          alt="Black Premium"
          class="h-105 w-full object-cover opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-500"
        />

        <div
          class="absolute inset-0 bg-linear-to-t from-black via-black/70 to-transparent"
        >
        </div>

        <div
          class="absolute bottom-0 p-6 text-white w-full transform translate-y-0 group-hover:-translate-y-2 transition-transform duration-500"
        >
          <h2
            class="text-3xl font-black italic text-center animate-fade-in-up"
            style="animation-delay: 200ms"
          >
            1. BLACK <span
              class="text-lime-500 group-hover:text-white transition-colors duration-300"
              >PREMIUM</span
            >
          </h2>

          <p
            class="mt-2 text-sm text-gray-300 text-center animate-fade-in-up opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            style="animation-delay: 300ms"
          >
            Servicio completo premium
          </p>

          <div class="mt-6 grid grid-cols-4 gap-4 text-center">
            <div
              class="transform hover:scale-125 transition-transform duration-300 hover:animate-bounce"
              style="animation-delay: 400ms"
            >
              <p class="mt-1 text-xs">Exterior detallado</p>
            </div>

            <div
              class="transform hover:scale-125 transition-transform duration-300 hover:animate-bounce"
              style="animation-delay: 500ms"
            >
              <p class="mt-1 text-xs">Interior profundo</p>
            </div>

            <div
              class="transform hover:scale-125 transition-transform duration-300 hover:animate-bounce"
              style="animation-delay: 600ms"
            >
              <p class="mt-1 text-xs">Protección y brillo</p>
            </div>

            <div
              class="transform hover:scale-125 transition-transform duration-300 hover:animate-bounce"
              style="animation-delay: 700ms"
            >
              <p class="mt-1 text-xs">Acabado premium</p>
            </div>
          </div>

          <div
            class="mt-6 text-center opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
            <h3 class="text-xl font-black italic">
              CAR<span class="text-lime-500">WASH</span>
            </h3>

            <p class="text-xs tracking-[0.4em] text-gray-400">BLACK</p>
          </div>
        </div>
      </article>

      <!-- CARD 2 -->
