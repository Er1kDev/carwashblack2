---
import { Image } from "astro:assets";
import AutoExterior from "../assets/images/auto-exterior.webp";
import AutoInterior from "../assets/images/auto-interior.webp";
import AutoCerca from "../assets/images/auto-cerca.webp";
import JeepXl from "../assets/images/jeepxl.webp";
import EntregaLlave from "../assets/images/entrega-llaves.webp";
import Motocicleta from "../assets/images/motocicleta-servicio.webp";

const servicios = [
  {
    numero: 1,
    titulo: "BLACK",
    acento: "PREMIUM",
    imagen: AutoExterior,
    alt: "Auto negro con espuma durante un lavado premium",
    descripcion: "Servicio completo premium",
    incluye: [
      "Exterior detallado",
      "Interior profundo",
      "Protección y brillo",
      "Acabado premium",
    ],
  },
  {
    numero: 2,
    titulo: "BLACK",
    acento: "INTERIOR",
    imagen: AutoInterior,
    alt: "Limpieza profunda del interior de un vehículo",
    descripcion: "Limpieza interior profunda",
    incluye: [
      "Aspirado completo",
      "Paneles y plásticos",
      "Eliminación de polvo",
      "Aromatización premium",
    ],
  },
  {
    numero: 3,
    titulo: "BLACK",
    acento: "EXPRESS",
    imagen: AutoCerca,
    alt: "Detalle del capó con gotas de agua tras un lavado exterior",
    descripcion: "Lavado exterior rápido y eficiente",
    incluye: [
      "Espuma activa",
      "Limpieza de llantas",
      "Secado premium",
      "Terminación brillante",
    ],
  },
  {
    numero: 4,
    titulo: "PROTECCIÓN Y",
    acento: "BRILLO",
    imagen: JeepXl,
    alt: "SUV negro con acabado brillante y protegido",
    descripcion: "Protección visual y acabado brillante",
    incluye: [
      "Productos premium",
      "Protección de pintura",
      "Acabado brillante",
      "Efecto renovado",
    ],
  },
  {
    numero: 5,
    titulo: "RETIRO Y",
    acento: "ENTREGA A DOMICILIO",
    imagen: EntregaLlave,
    alt: "Entrega de llaves de un vehículo lavado",
    descripcion: "Comodidad y seguridad para ti",
    incluye: [
      "Retiro del vehículo",
      "Entrega coordinada",
      "Atención rápida y segura",
    ],
  },
  {
    numero: 6,
    titulo: "MOTOCICLETAS",
    acento: "ENDURO",
    imagen: Motocicleta,
    alt: "Motocicleta enduro después de su lavado",
    descripcion: "Limpieza especializada para tu moto",
    incluye: [
      "Hidrolavado snow foam",
      "Eliminación de barro",
      "Terminación renovada",
    ],
  },
];
---

<div id="servicios" class="scroll-mt-20 py-6 md:py-12">
  <h3 class="py-12 text-center text-4xl font-semibold">Servicios</h3>

  <section>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        servicios.map((servicio, index) => (
          <article
            class="group relative animate-fade-in-up overflow-hidden rounded-2xl bg-neutral-900 transition-all duration-500 hover:scale-[1.03] hover:shadow-2xl hover:shadow-lime-500/20"
            style={`animation-delay: ${(index + 1) * 100}ms`}
          >
            <Image
              src={servicio.imagen}
              alt={servicio.alt}
              loading={index < 3 ? "eager" : "lazy"}
              class="h-105 w-full object-cover opacity-70 transition-all duration-500 group-hover:scale-110 group-hover:opacity-100"
            />

            <div class="absolute inset-0 bg-linear-to-t from-black via-black/70 to-transparent" />

            <div class="absolute bottom-0 w-full translate-y-0 p-6 text-white transition-transform duration-500 group-hover:-translate-y-2">
              <h2 class="animate-fade-in-up text-center text-3xl font-black italic">
                {servicio.numero}. {servicio.titulo}{" "}
                <span class="text-lime-500 transition-colors duration-300 group-hover:text-white">
                  {servicio.acento}
                </span>
              </h2>

              <p class="mt-2 text-center text-sm text-gray-300">
                {servicio.descripcion}
              </p>

              <div
                class={`mt-6 grid gap-4 text-center ${
                  servicio.incluye.length === 4 ? "grid-cols-4" : "grid-cols-3"
                }`}
              >
                {servicio.incluye.map((item) => (
                  <div class="transition-transform duration-300 hover:scale-110">
                    <p class="mt-1 text-xs">{item}</p>
                  </div>
                ))}
              </div>

              <div class="mt-6 hidden text-center md:block md:opacity-0 md:transition-opacity md:duration-500 md:group-hover:opacity-100">
                <h3 class="text-xl font-black italic">
                  CAR<span class="text-lime-500">WASH</span>
                </h3>
                <p class="text-xs tracking-[0.4em] text-gray-400">BLACK</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</div>
