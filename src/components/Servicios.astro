---

---

<div class="py-6 md:py-12 animate-blurred-fade-in">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2 px-4 md:px-12">
    <div
      class="w-full flex flex-col items-center rounded-lg py-4 inset-shadow-sm inset-shadow-black bg-neutral-950"
    >
      <div class="h-full flex flex-col items-center justify-start">
        <h2 class="text-2xl md:text-3xl font-semibold py-4">
          <span class="flex flex-col items-center justify-center gap-2">
            <svg
              width="30"
              height="30"
              viewBox="0 0 24 24"
              class="animate-spin-slow"
            >
              <use xlink:href="#wash-icon"></use>
            </svg>
            <span class="text-center">Lavado Full Incluye</span>
          </span>
        </h2>
        <p class="text-base md:text-xl text-center mb-2 italic">
          Aspirado Profundo Completo
        </p>
        <p class="text-base md:text-xl text-center mb-2 italic">
          Silicona Interior
        </p>
        <p class="text-base md:text-xl text-center mb-2 italic">
          Hidrolavado Snowfoam
        </p>
        <p class="text-base md:text-xl text-center mb-2 italic">
          Renovador de Plásticos y Neumáticos
        </p>
        <p class="text-base md:text-xl text-center mb-2 italic">
          Perfumado Final
        </p>
      </div>
    </div>
    <div
      class="flex flex-col items-center rounded-lg py-4 inset-shadow-sm inset-shadow-black bg-neutral-950"
    >
      <div class="h-full flex flex-col items-center justify-start">
        <h2 class="text-2xl md:text-3xl font-semibold text-center py-4">
          <span class="flex flex-col items-center justify-center gap-2">
            <svg
              width="30"
              height="30"
              viewBox="0 0 24 24"
              class="animate-pulse"
            >
              <use xlink:href="#icon-calendar-week"></use>
            </svg>
            <span class="text-center">Horarios</span>
          </span>
        </h2>

        <p class="text-xl md:text-2xl text-center mb-2">Lunes a Viernes</p>
        <p class="text-lg md:text-xl text-center mb-2 italic">18:00 - 20:00</p>
        <p class="text-xl md:text-2xl text-center mb-2">Sábados</p>
        <p class="text-lg md:text-xl text-center mb-2 italic">10:00 - 14:00</p>
      </div>
    </div>
  </div>
</div>
