---
import { Image } from "astro:assets";
import FondoAuto from "../assets/images/fondo-auto.webp";

interface Props {
  title?: string;
  subtitle?: string;
  slogan?: string;
}

const {
  title = "CarWash Black",
  subtitle = "Lavado de automóviles",
  slogan = "¡vive rapido, lava limpio!",
} = Astro.props;
---

<div class="flex flex-col items-center animate-blurred-fade-in">
  <!-- IMAGEN DE FONDO -->
  <Image
    src={FondoAuto}
    alt="Fondo de inicio de CarWash Black"
    loading="eager"
    class="object-cover h-full mask-x-from-70% mask-x-to-90% mask-y-from-70% mask-y-to-90% rounded-xl"
  />

  <!-- TEXTO ENCIMA DE LA IMAGEN -->
  <div class="flex flex-col justify-center items-center -mt-20 md:-mt-40 z-10">
    <h1
      class="text-5xl md:text-7xl font-extrabold text-center tracking-tight leading-tight hover:scale-105 transition-transform duration-700"
    >
      {title}
    </h1>
    <h2
      class="text-2xl md:text-4xl font-medium text-white hover:scale-105 transition-transform duration-700"
    >
      {subtitle}
    </h2>
    <p
      class="text-base md:text-xl mt-4 uppercase font-light text-center py-2 px-4 rounded-full bg-black border border-gray-300 hover:bg-white hover:text-black transition-colors duration-300"
    >
      {slogan}
    </p>

    <!-- ICONOS DE REDES SOCIALES -->
    <div class="pt-6 md:pt-8 gap-8 flex flex-row justify-center items-center">
      <a
        href="https://web.facebook.com/profile.php?id=100086680427768"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-blue-600 p-2 hover:scale-125 transition-transform"
      >
        <svg class="w-8 h-8" fill="currentColor">
          <title>Facebook</title>
          <use href="#facebook-icon"></use>
        </svg>
      </a>

      <a
        href="https://www.instagram.com/carwash__black/"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-gradient-to-tr from-yellow-300 via-pink-600 to-purple-600 p-2 hover:scale-125 transition-transform"
      >
        <svg class="w-8 h-8" fill="currentColor">
          <title>Instagram</title>
          <use href="#instagram-icon"></use>
        </svg>
      </a>
      <a
        href="https://api.whatsapp.com/send?phone=56939570405"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-green-500 p-2 hover:scale-125 transition-transform"
      >
        <svg class="w-8 h-8" fill="currentColor">
          <title>WhatsApp</title>
          <use href="#whatsapp-icon"></use>
        </svg>
      </a>
    </div>
    <!-- FIN ICONOS DE REDES SOCIALES -->
  </div>
</div>
