---
import { Image } from "astro:assets";
import Logo from "../assets/images/logo.webp";
import { site, whatsappLink } from "../lib/site";

const redes = [
  {
    href: site.social.facebook,
    label: "Facebook",
    icon: "facebook-icon",
    className: "bg-blue-600",
  },
  {
    href: site.social.instagram,
    label: "Instagram",
    icon: "instagram-icon",
    className:
      "bg-linear-to-tr from-yellow-300 via-pink-600 to-purple-600",
  },
  {
    href: site.social.whatsapp,
    label: "Catálogo de WhatsApp",
    icon: "whatsapp-icon",
    className: "bg-green-500",
  },
];
---

<section id="inicio" class="flex flex-col items-center pt-14 md:pt-16">
  <Image
    src={Logo}
    alt="Logo de Carwash Black, lavado premium automotriz en Linares"
    loading="eager"
    fetchpriority="high"
    widths={[256, 512, 1024]}
    sizes="(min-width: 1024px) 512px, (min-width: 768px) 448px, 320px"
    class="w-full max-w-xs object-contain md:max-w-md lg:max-w-lg"
  />

  <h1
    class="mt-6 max-w-2xl text-center text-2xl leading-tight md:mt-8 md:text-4xl"
  >
    Lavado y detailing <span class="text-lime-500">premium</span> en Linares
  </h1>

  <p class="mt-3 max-w-md text-center text-sm text-gray-400 md:text-base">
    Lavado full, interior profundo y protección de pintura. Retiro y entrega a
    domicilio.
  </p>

  <div class="mt-6 flex flex-col items-center gap-3 sm:flex-row">
    <a
      href={whatsappLink("Hola, quiero agendar un lavado en Carwash Black.")}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-lime-500 px-6 py-3 text-sm font-bold text-black transition hover:bg-lime-400 hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-400"
    >
      <svg class="h-5 w-5" fill="currentColor" aria-hidden="true">
        <use href="#whatsapp-icon"></use>
      </svg>
      Agendar por WhatsApp
    </a>

    <a
      href="#precios"
      class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-gray-200 transition hover:border-lime-500/60 hover:text-lime-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-400"
    >
      Ver precios
    </a>
  </div>

  <p
    class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs text-gray-500"
  >
    <span>Lun a Vie 18:00 - 20:00</span>
    <span aria-hidden="true">·</span>
    <span>Sáb 10:00 - 14:00</span>
  </p>

  <div class="flex flex-row items-center justify-center gap-6 pt-6 md:gap-8 md:pt-8">
    {
      redes.map((red) => (
        <a
          href={red.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={red.label}
          class={`rounded-full p-2 transition-transform duration-300 hover:scale-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white ${red.className}`}
        >
          <svg class="h-7 w-7" fill="currentColor" aria-hidden="true">
            <use href={`#${red.icon}`}></use>
          </svg>
        </a>
      ))
    }
  </div>
</section>
